<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivHabitIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_heart"
        android:tint="@color/primaryPink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tvHabitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Habit Title"
            android:textColor="@color/darkText"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHabitDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Habit Description"
            android:textColor="@color/lightText"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnEditHabit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="@color/lightText"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"/>

    <CheckBox
        android:id="@+id/cbHabit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/primaryPink" />
</LinearLayout>

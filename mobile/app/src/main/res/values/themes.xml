<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClinicCareMobile" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryPink</item>
        <item name="colorPrimaryVariant">@color/primaryPurple</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primaryPurple</item>
        <item name="colorSecondaryVariant">@color/primaryPink</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/lightBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/lightBackground</item>
        <item name="colorSurface">@color/cardBackground</item>
        <item name="colorOnSurface">@color/darkText</item>

        <!-- Global Widget Styles -->
        <item name="textInputStyle">@style/Widget.ClinicCare.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.ClinicCare.Button</item>
    </style>

    <!-- Custom TextInputLayout Style -->
    <style name="Widget.ClinicCare.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primaryPink</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.ClinicCare.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_gradient_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.ClinicCareMobile" parent="Base.Theme.ClinicCareMobile" />
</resources>